- hosts: coredns
  serial: 1  # 逐台执行，确保 DNS 服务连续性
  vars:
    # 镜像仓库配置
    coredns_registry: "your-docker-repo.demo.com:4003"
    coredns_image_name: "coredns"
    # CoreDNS 和 Go 版本
    coredns_build_version: "1.14.1"
    coredns_go_version: "1.24"
    # 用于 Makefile init-system 配置的 DNS 服务器
    coredns_system_dns_servers:
      - 192.168.0.100
      - 192.168.0.101

    # CoreDNS 版本和镜像配置
    coredns_version: "1.14.1-view"
    coredns_image: "your-docker-repo.demo.com:4002/coredns"
    docker_registry_mirrors:
      - "https://your-docker-repo.demo.com:4002"
    docker_insecure_registries:
      - "your-docker-repo.demo.com"
    # 是否安装 Docker, 默认关闭
    docker_install_enabled: false
    # 上游 DNS 服务器
    coredns_upstream_servers:
      - 192.168.0.100
      - 192.168.0.101
    coredns_cache_ttl: 300
    # 网络配置, 确保与现有网络不冲突, 且与Makefile中定义的网络一致
    coredns_network_subnet: "192.168.100.0/24"
    coredns_network_gateway: "192.168.100.1"
    # 配置验证和重载
    coredns_validate_config: true
    coredns_reload_method: "reload"
    # ============================================================
    # hosts 文件配置
    # ============================================================
    coredns_hosts_entries:
      # === 生产环境运维 ===
      - 10.100.1.212 git-ops.demo.cn
      # === 开发环境基础设施 ===
      - 10.21.70.81 uc-dev.demo.cn
    # ============================================================
    # 特定域名转发
    # ============================================================
    coredns_forward_zones:
      # GitHub 相关
      - domains:
          - github.com
          - githubassets.com
          - githubusercontent.com
        upstream: 223.5.5.5
      # Google 相关
      - domains:
          - google.com
          - google.com.hk
        upstream: 223.5.5.5
    # ============================================================
    # 视图配置 (View-based DNS - 智能解析)
    # CoreDNS 1.14.1 语法: expr incidr(client_ip(), 'CIDR')
    # ============================================================
    coredns_view_enabled: true
    # 视图智能解析规则
    coredns_view_rules:
      - domain: "test2026.demo.cn"
        views:
          - name: "internal"
            cidr: "10.21.0.0/16"
            ttl: 60
            ips:
              - "10.21.70.81"
          - name: "aliyun"
            cidr: "10.100.1.0/24"
            ttl: 60
            ips:
              - "192.168.70.81"
          - name: "dmz"
            cidr: "10.21.36.0/22"
            ttl: 60
            ips:
              - "10.21.70.61"
          - name: "vpn"
            cidr: "10.20.0.0/16"
            ttl: 60
            ips:
              - "10.20.70.61"
              - "10.20.70.81"
        default:
          ttl: 60
          ips:
            - "10.21.70.61"
    # ============================================================
    # 正则匹配解析 - 泛域名
    # 使用 Go 正则表达式语法
    # ============================================================
    coredns_regex_rules:
      - zone: "internal.demo.cn"
        rules:
          # 匹配 *-dev.internal.demo.cn (如 an-dev, ac-dev, test-dev)
          - pattern: "^[a-zA-Z0-9]+-dev[.]demo[.]cn[.]$"
            comment: "泛域名 *-dev.internal.demo.cn 解析到开发环境"
            ttl: 60
            ips:
              - "10.21.70.81"
          # 匹配 *-ops.internal.demo.cn (如 git-ops, jenkins-ops)
          - pattern: "^[a-zA-Z0-9]+-ops[.]demo[.]cn[.]$"
            comment: "泛域名 *-ops.internal.demo.cn 解析到生产环境"
            ttl: 60
            ips:
              - "10.100.1.212"

    # ============================================================
    # AD 域控 DNS 集成配置 (企业环境)
    # 将 AD 域名和反向解析转发给域控 DNS 服务器
    # ============================================================
    # 是否启用 AD DNS 集成 (默认关闭,按需开启)
    coredns_ad_dns_enabled: false

    # # 启用 AD DNS 后的配置示例:
    # coredns_ad_dns_enabled: true
    #
    # # AD 域控 DNS 服务器 (主/备)
    # coredns_ad_dns_servers:
    #   - "192.168.1.10"   # 主域控 DNS
    #   - "192.168.1.11"   # 备域控 DNS
    #
    # # AD 域名列表 (转发给域控)
    # coredns_ad_domains:
    #   - "company.local"              # AD 主域
    #   - "corp.company.local"         # AD 子域
    #   - "_msdcs.company.local"       # AD 服务定位
    #   - "_sites.company.local"       # AD 站点
    #   - "_tcp.company.local"         # AD SRV 记录
    #   - "_udp.company.local"         # AD SRV 记录
    #
    # # AD 反向解析区域 (PTR 记录)
    # coredns_ad_reverse_zones:
    #   - "1.168.192.in-addr.arpa"     # 192.168.1.0/24
    #   - "2.168.192.in-addr.arpa"     # 192.168.2.0/24
    #
    # # DNS 转发策略: sequential (顺序,主域控优先) 或 random (随机,负载均衡)
    # coredns_ad_dns_policy: "sequential"

    # ============================================================
    # 内部 Zone 配置 - 完整 DNS 记录支持
    # 支持: A, AAAA, CNAME, MX, TXT, SRV, NS, PTR, CAA
    # ============================================================
    coredns_internal_zones:
      # ============================================================
      # 示例: 内部域名 internal.demo.cn
      # 注意: 正则规则 (coredns_regex_rules) 会自动合并到此 zone
      # ============================================================
      - name: "internal.demo.cn"
        default_ttl: 3600
        primary_ns: "ns1.internal.demo.cn"
        admin_email: "admin.internal.demo.cn"
        records:
          # ============================================================
          # A 记录 - IPv4 地址映射 (推荐 TTL: 60 秒)
          # ============================================================
          - type: "A"
            name: "@"
            value: "192.168.1.10"
            ttl: 60
            comment: "根域名"
          - type: "A"
            name: "www"
            value: "192.168.1.10"
            ttl: 60
          - type: "A"
            name: "ns1"
            value: "192.168.1.1"
            ttl: 60
          - type: "A"
            name: "ns2"
            value: "192.168.1.2"
            ttl: 60
          - type: "A"
            name: "web"
            value: "192.168.1.20"
            ttl: 60
          - type: "A"
            name: "api"
            value: "192.168.1.21"
            ttl: 60
          - type: "A"
            name: "db"
            value: "192.168.1.30"
            ttl: 60
          - type: "A"
            name: "redis"
            value: "192.168.1.31"
            ttl: 60

          # ============================================================
          # AAAA 记录 - IPv6 地址映射 (推荐 TTL: 60 秒)
          # ============================================================
          - type: "AAAA"
            name: "@"
            value: "2001:db8::10"
            ttl: 60
          - type: "AAAA"
            name: "www"
            value: "2001:db8::10"
            ttl: 60
          - type: "AAAA"
            name: "ipv6"
            value: "2001:db8::100"
            ttl: 60

          # ============================================================
          # CNAME 记录 - 别名 (推荐 TTL: 1200 秒 / 20分钟)
          # ============================================================
          - type: "CNAME"
            name: "mail"
            value: "mx1.internal.demo.cn"
            ttl: 1200
          - type: "CNAME"
            name: "ftp"
            value: "web.internal.demo.cn"
            ttl: 1200
          - type: "CNAME"
            name: "cdn"
            value: "web.internal.demo.cn"
            ttl: 1200
          - type: "CNAME"
            name: "portal"
            value: "www.internal.demo.cn"
            ttl: 1200

          # ============================================================
          # MX 记录 - 邮件服务器 (推荐 TTL: 3600 秒 / 1小时)
          # ============================================================
          - type: "MX"
            name: "@"
            value: "mx1.internal.demo.cn"
            priority: 10
            ttl: 3600
            comment: "主邮件服务器"
          - type: "MX"
            name: "@"
            value: "mx2.internal.demo.cn"
            priority: 20
            ttl: 3600
            comment: "备邮件服务器"
          - type: "A"
            name: "mx1"
            value: "192.168.1.50"
            ttl: 60
          - type: "A"
            name: "mx2"
            value: "192.168.1.51"
            ttl: 60

          # ============================================================
          # TXT 记录 - 文本记录 (推荐 TTL: 1800 秒 / 30分钟)
          # 用途: SPF, DKIM, DMARC, 域名验证等
          # ============================================================
          # SPF 记录 - 发件人策略框架
          - type: "TXT"
            name: "@"
            value: "v=spf1 mx ip4:192.168.1.0/24 ~all"
            ttl: 1800
            comment: "SPF 记录"
          # DMARC 记录
          - type: "TXT"
            name: "_dmarc"
            value: "v=DMARC1; p=quarantine; rua=mailto:dmarc@internal.demo.cn"
            ttl: 1800
            comment: "DMARC 记录"
          # 域名验证
          - type: "TXT"
            name: "@"
            value: "google-site-verification=xxxxxxxxxx"
            ttl: 1800
            comment: "Google 域名验证"
          # 自定义文本
          - type: "TXT"
            name: "info"
            value: "This is internal domain"
            ttl: 1800

          # ============================================================
          # SRV 记录 - 服务定位 (推荐 TTL: 300 秒 / 5分钟)
          # 格式: _service._proto.name TTL IN SRV priority weight port target
          # ============================================================
          # LDAP 服务
          - type: "SRV"
            name: "_ldap._tcp"
            value: "ldap.internal.demo.cn"
            port: 389
            priority: 0
            weight: 100
            ttl: 300
            comment: "LDAP 服务"
          # Kerberos 服务
          - type: "SRV"
            name: "_kerberos._tcp"
            value: "kdc.internal.demo.cn"
            port: 88
            priority: 0
            weight: 100
            ttl: 300
          # XMPP 服务
          - type: "SRV"
            name: "_xmpp-server._tcp"
            value: "xmpp.internal.demo.cn"
            port: 5269
            priority: 0
            weight: 100
            ttl: 300

          # ============================================================
          # CAA 记录 - 证书授权 (推荐 TTL: 3600 秒)
          # ============================================================
          - type: "CAA"
            name: "@"
            flags: 0
            tag: "issue"
            value: "letsencrypt.org"
            ttl: 3600
            comment: "只允许 Let's Encrypt 颁发证书"
          - type: "CAA"
            name: "@"
            flags: 0
            tag: "iodef"
            value: "mailto:security@internal.demo.cn"
            ttl: 3600
            comment: "证书问题通知邮箱"

      # 示例: 反向解析区域
      - name: "1.168.192.in-addr.arpa"
        default_ttl: 3600
        records:
          # PTR 记录 - 反向解析
          - type: "PTR"
            name: "10"
            value: "www.internal.demo.cn"
            ttl: 3600
          - type: "PTR"
            name: "20"
            value: "web.internal.demo.cn"
            ttl: 3600
          - type: "PTR"
            name: "30"
            value: "db.internal.demo.cn"
            ttl: 3600
          - type: "PTR"
            name: "50"
            value: "mx1.internal.demo.cn"
            ttl: 3600

