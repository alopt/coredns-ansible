# {{ ansible_managed }}
# CoreDNS Configuration (v1.14.1)
# 支持 SIGUSR1 热加载 - 经常修改的配置通过 import 导入
# ============================================================

# ============================================================
# 导入外部配置 (支持 SIGUSR1 热加载)
# 修改以下配置后执行: docker kill --signal=SIGUSR1 coredns
# ============================================================

# 智能解析 - View-based DNS (根据客户端 IP 返回不同结果)
import {{ coredns_deploy_dir }}/config/zones/views.conf

# 正则匹配解析 - 泛域名 (*-dev.internal.example.com 等)
import {{ coredns_deploy_dir }}/config/zones/regex.conf

# 特定域名转发 (GitHub, Google 等)
import {{ coredns_deploy_dir }}/config/zones/forward-zones.conf

# 内部 Zone 配置 (A, AAAA, CNAME, MX, TXT, SRV 等记录)
import {{ coredns_deploy_dir }}/config/zones/internal-zones.conf

# ============================================================
# 主区块配置 - 通用 DNS 解析 (基础配置，较少修改)
# ============================================================
. {
{% if coredns_hosts_entries | default([]) | length > 0 %}
    # 自定义 hosts 解析
    hosts {{ coredns_deploy_dir }}/config/hosts {
        fallthrough
    }

{% endif %}
    # 转发到上游 DNS 服务器
    forward . {{ coredns_upstream_servers | join(' ') }} {
        prefer_udp
        health_check 5s
        max_concurrent {{ coredns_forward_max_concurrent }}
    }

    # 缓存配置 (高性能调优)
    cache {
        # 正向缓存: 最大条目数 + TTL 上限
        success {{ coredns_cache_success_size }} {{ coredns_cache_ttl }}
        # 负向缓存: NXDOMAIN/NODATA 单独设置较短 TTL
        denial {{ coredns_cache_denial_size }} {{ coredns_cache_denial_ttl }}
{% if coredns_cache_prefetch | default(0) | int > 0 %}
        # 预取: 高频域名在 TTL 到期前自动刷新，减少缓存穿透
        prefetch {{ coredns_cache_prefetch }} 1h
{% endif %}
{% if coredns_cache_serve_stale | default(0) | int > 0 %}
        # 过期缓存容灾: 上游故障时继续返回过期记录
        serve_stale {{ coredns_cache_serve_stale }}s
{% endif %}
    }

{% if coredns_bufsize_enabled | default(false) %}
    # EDNS 缓冲区大小 (RFC 8020 推荐 1232，避免 UDP 分片)
    bufsize {{ coredns_bufsize }}

{% endif %}
    # DNS 查询日志 (标准格式)
    log . {{ coredns_log_format }}

    # 错误日志
    errors

    # 就绪检查 (区别于健康检查，标识服务已准备好接收流量)
    ready :8181

    # 健康检查端点
    health :{{ coredns_health_port }}

    # Prometheus 指标
    prometheus :{{ coredns_metrics_port }}

    # 循环检测
    loop

{% if coredns_reload_interval | default(false) %}
    # 重新加载配置 (SIGUSR1 触发)
    reload {{ coredns_reload_interval }}

{% endif %}
    # 负载均衡
    loadbalance round_robin
}

# ============================================================
# 健康检查专用域名
# ============================================================
health.check {
    whoami
}
