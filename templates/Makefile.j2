# {{ ansible_managed }}
# CoreDNS with View Plugin - Makefile
# ============================================================

# 配置变量
REGISTRY := {{ coredns_registry }}
IMAGE_NAME := {{ coredns_image_name }}
COREDNS_VERSION := {{ coredns_build_version }}
GO_VERSION := {{ coredns_go_version }}
{% if (coredns_view_rules is not defined or coredns_view_rules | length == 0) and (coredns_network_bridge | default(false)) %}
DOCKER_NETWORKS := {{ coredns_network_subnet }}
{% endif %}

{% raw %}
# 完整镜像标签
IMAGE_TAG := $(REGISTRY)/$(IMAGE_NAME):$(COREDNS_VERSION)-view
IMAGE_TAG_LATEST := $(REGISTRY)/$(IMAGE_NAME):latest

# 构建参数
BUILD_ARGS := --build-arg COREDNS_VERSION=$(COREDNS_VERSION) \
              --build-arg GO_VERSION=$(GO_VERSION)

# ============================================================
# 默认目标
# ============================================================
.PHONY: help
help:
	@echo "CoreDNS with View Plugin - 构建工具"
	@echo "============================================================"
	@echo ""
	@echo "用法: make [目标]"
	@echo ""
	@echo "构建目标:"
	@echo "  build          构建 Docker 镜像"
	@echo "  build-no-cache 无缓存构建 Docker 镜像"
	@echo ""
	@echo "推送目标:"
	@echo "  push           推送镜像到 Nexus 仓库"
	@echo "  push-latest    推送 latest 标签"
	@echo ""
	@echo "组合目标:"
	@echo "  all            构建并推送镜像"
	@echo "  release        构建并推送 (版本 + latest)"
	@echo ""
	@echo "部署目标:"
	@echo "  up             启动服务 (首次自动初始化系统)"
	@echo "  down           停止服务 (docker-compose down)"
	@echo "  restart        重启服务"
	@echo "  reload         重载配置 (不重启容器)"
	@echo "  logs           查看日志"
	@echo "  status         查看状态"
{% endraw %}
{% if (coredns_view_rules is not defined or coredns_view_rules | length == 0) and (coredns_network_bridge | default(false)) %}
	@echo "  init-system    手动初始化系统 (禁用 systemd-resolved, 配置转发)"
{% else %}
	@echo "  init-system    手动初始化系统 (禁用 systemd-resolved, 配置 DNS)"
{% endif %}
{% raw %}
	@echo "  reinit-system  强制重新初始化系统"
	@echo ""
	@echo "测试目标:"
	@echo "  test           测试 DNS 解析"
	@echo "  test-view      测试视图解析"
	@echo ""
	@echo "其他目标:"
	@echo "  login          登录 Nexus 仓库"
	@echo "  clean          清理构建缓存"
	@echo "  info           显示配置信息"
	@echo ""

# ============================================================
# 构建目标
# ============================================================
.PHONY: build
build:
	@echo ">>> 构建 CoreDNS 镜像: $(IMAGE_TAG)"
	docker build $(BUILD_ARGS) -t $(IMAGE_TAG) .
	@echo ">>> 构建完成"

.PHONY: build-no-cache
build-no-cache:
	@echo ">>> 无缓存构建 CoreDNS 镜像: $(IMAGE_TAG)"
	docker build --no-cache $(BUILD_ARGS) -t $(IMAGE_TAG) .
	@echo ">>> 构建完成"

# ============================================================
# 推送目标
# ============================================================
.PHONY: login
login:
	@echo ">>> 登录 Nexus 仓库: $(REGISTRY)"
	docker login $(REGISTRY)

.PHONY: push
push:
	@echo ">>> 推送镜像: $(IMAGE_TAG)"
	docker push $(IMAGE_TAG)
	@echo ">>> 推送完成"

.PHONY: push-latest
push-latest:
	@echo ">>> 标记 latest 标签"
	docker tag $(IMAGE_TAG) $(IMAGE_TAG_LATEST)
	@echo ">>> 推送 latest 镜像: $(IMAGE_TAG_LATEST)"
	docker push $(IMAGE_TAG_LATEST)
	@echo ">>> 推送完成"

# ============================================================
# 组合目标
# ============================================================
.PHONY: all
all: build push
	@echo ">>> 构建并推送完成"

.PHONY: release
release: build push push-latest
	@echo ">>> 发布完成: $(IMAGE_TAG) / $(IMAGE_TAG_LATEST)"

# ============================================================
# 部署目标
# ============================================================

# 系统初始化标记文件
INIT_FLAG := /var/lib/coredns/.initialized

.PHONY: init-system
init-system:
	@if [ ! -f $(INIT_FLAG) ]; then \
		echo ">>> 首次运行，初始化系统配置..."; \
		echo ">>> 停止并禁用 systemd-resolved"; \
		systemctl stop systemd-resolved || true; \
		systemctl disable systemd-resolved || true; \
		echo ">>> 配置 /etc/resolv.conf"; \
		rm -f /etc/resolv.conf; \
{% endraw %}{%- for dns_server in coredns_system_dns_servers %}
		echo "nameserver {{ dns_server }}" >> /etc/resolv.conf; \
{%- endfor %}
{%- if (coredns_view_rules is not defined or coredns_view_rules | length == 0) and (coredns_network_bridge | default(false)) %}
{% raw %}		echo ">>> 启用 IP 转发"; \
		grep -q "net.ipv4.ip_forward=1" /etc/sysctl.conf || echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf; \
		sysctl -p; \
		echo ">>> 配置 iptables NAT, 如果已有安全组配置建议/etc/docker/daemon.json中配置"iptables": false需要手改为true"; \
		iptables -t nat -C POSTROUTING -s $(DOCKER_NETWORKS) -o eth0 -j MASQUERADE 2>/dev/null || \
			iptables -t nat -A POSTROUTING -s $(DOCKER_NETWORKS) -o eth0 -j MASQUERADE; \
{% endraw %}
{%- endif %}
{% raw %}		echo ">>> 创建初始化标记"; \
		mkdir -p /var/lib/coredns; \
		touch $(INIT_FLAG); \
		echo ">>> 系统初始化完成"; \
	else \
		echo ">>> 系统已初始化，跳过"; \
	fi

.PHONY: reinit-system
reinit-system:
	@echo ">>> 强制重新初始化系统"
	@rm -f $(INIT_FLAG)
	@$(MAKE) init-system

.PHONY: up
up: init-system
	@echo ">>> 启动 CoreDNS 服务"
	docker-compose up -d
	@echo ">>> 服务已启动"

.PHONY: down
down:
	@echo ">>> 停止 CoreDNS 服务"
	docker-compose down
	@echo ">>> 服务已停止"

.PHONY: restart
restart:
	@echo ">>> 重启 CoreDNS 服务"
	docker-compose restart
	@echo ">>> 服务已重启"

.PHONY: reload
reload:
	@echo ">>> 重载 CoreDNS 配置"
	docker kill --signal=SIGUSR1 coredns
	@echo ">>> 配置已重载"

.PHONY: logs
logs:
	docker-compose logs -f --tail=100 coredns

.PHONY: status
status:
	@echo ">>> 容器状态:"
	docker-compose ps
	@echo ""
	@echo ">>> 健康检查:"
{% endraw %}
	@docker inspect --format='{{ '{{' }}.State.Health.Status{{ '}}' }}' coredns 2>/dev/null || echo "容器未运行"
{% raw %}

# ============================================================
# 测试目标
# ============================================================
.PHONY: test
test:
	@echo ">>> 测试 DNS 解析"
	@echo "--- 测试 health.check ---"
	nslookup health.check 127.0.0.1 || true
	@echo ""
	@echo "--- 测试外部域名 ---"
	nslookup www.baidu.com 127.0.0.1 || true
	@echo ""
	@echo ">>> 测试完成"

.PHONY: test-view
test-view:
	@echo ">>> 测试视图解析 (需要配置 view)"
{% endraw %}
{% if coredns_view_enabled and coredns_view_rules | length > 0 %}
	@echo "--- 测试 {{ coredns_view_rules[0].domain }} ---"
	nslookup {{ coredns_view_rules[0].domain }} 127.0.0.1 || true
{% else %}
	@echo "--- 测试 test2026.example.com ---"
	nslookup test2026.example.com 127.0.0.1 || true
{% endif %}
{% raw %}
	@echo ""
	@echo ">>> 测试完成"

# ============================================================
# 其他目标
# ============================================================
.PHONY: clean
clean:
	@echo ">>> 清理 Docker 构建缓存"
	docker builder prune -f
	@echo ">>> 清理完成"

.PHONY: info
info:
	@echo "============================================================"
	@echo "CoreDNS 构建配置信息"
	@echo "============================================================"
	@echo "Registry:         $(REGISTRY)"
	@echo "Image Name:       $(IMAGE_NAME)"
	@echo "CoreDNS Version:  $(COREDNS_VERSION)"
	@echo "Go Version:       $(GO_VERSION)"
{% endraw %}
{% if (coredns_view_rules is not defined or coredns_view_rules | length == 0) and (coredns_network_bridge | default(false)) %}
	@echo "Network Mode:     bridge"
	@echo "Docker Networks:  $(DOCKER_NETWORKS)"
{% else %}
	@echo "Network Mode:     host"
{% endif %}
{% raw %}
	@echo "Image Tag:        $(IMAGE_TAG)"
	@echo "Image Tag Latest: $(IMAGE_TAG_LATEST)"
	@echo "============================================================"

# ============================================================
# Pull 目标 (从仓库拉取)
# ============================================================
.PHONY: pull
pull:
	@echo ">>> 从仓库拉取镜像: $(IMAGE_TAG)"
	docker pull $(IMAGE_TAG)
	@echo ">>> 拉取完成"
{% endraw %}
