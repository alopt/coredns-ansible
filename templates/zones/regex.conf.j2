# {{ ansible_managed }}
# 正则匹配解析 - 泛域名配置
# 使用 Go 正则表达式语法
# 支持 SIGUSR1 热加载
# 注意: 如果域名在 coredns_internal_zones 中也有定义，规则会合并到 internal-zones.conf

{# 获取所有 internal_zones 的域名列表 #}
{% set internal_zone_names = coredns_internal_zones | default([]) | map(attribute='name') | list %}

{% if coredns_regex_rules | default([]) | length > 0 %}
{% for zone_rule in coredns_regex_rules %}
{% if zone_rule.zone not in internal_zone_names %}
# 正则匹配: {{ zone_rule.zone }}
{{ zone_rule.zone }} {
{% if coredns_hosts_entries | default([]) | length > 0 %}
    # hosts 优先于正则匹配
    hosts {{ coredns_deploy_dir }}/config/hosts {
        fallthrough
    }
{% endif %}
{% for rule in zone_rule.rules %}
    template IN A {
        # {{ rule.comment | default('正则匹配规则') }}
        match {{ rule.pattern }}
{% for ip in rule.ips %}
        answer "{% raw %}{{ .Name }}{% endraw %} {{ rule.ttl | default(60) }} IN A {{ ip }}"
{% endfor %}
        fallthrough
    }
    template IN AAAA {
        # {{ rule.comment | default('正则匹配规则') }} - IPv6 NODATA (防止 NXDOMAIN 阻断 A 查询)
        match {{ rule.pattern }}
        rcode NOERROR
        fallthrough
    }
{% endfor %}
    log . {{ coredns_log_format }}
    errors
}

{% else %}
# 跳过 {{ zone_rule.zone }} - 已在 coredns_internal_zones 中定义，规则已合并到 internal-zones.conf
{% endif %}
{% endfor %}
{% else %}
# 无正则匹配规则配置
{% endif %}
